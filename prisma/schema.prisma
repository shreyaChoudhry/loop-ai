generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

enum FeedbackSource {
  WEBSITE
  EMAIL
  SUPPORT
  SURVEY
  OTHER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum PublicStatus {
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  NOT_PLANNED
}

model Workspace {
  id                String     @id @default(cuid())
  name              String
  slug              String?    @unique
  code              String?
  portalEnabled     Boolean    @default(true)
  portalName        String?
  portalDescription String?
  portalLogoUrl     String?
  portalAccentColor String?    @default("#6655e8")
  showNotPlanned    Boolean    @default(false)
  digestEnabled     Boolean    @default(false)
  digestEmail       String?
  digestLastSentAt  DateTime?
  apiKey            String?    @unique
  createdAt         DateTime   @default(now())

  users             User[]
  feedback          Feedback[]
  themes            Theme[]
  reports           Report[]
  requests          Request[]
  votes             Vote[]

  @@index([createdAt])
  @@index([slug])
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String
  password    String
  role        UserRole  @default(VIEWER)
  workspaceId String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  source         FeedbackSource
  status         FeedbackStatus  @default(NEW)
  sentiment      Sentiment?
  sentimentScore Float?
  category       String?
  rating Int?
  createdAt      DateTime        @default(now())
  workspaceId    String
  
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  themes         FeedbackTheme[]
  embeddings     Embedding[]
  
  @@index([workspaceId])
  @@index([status])
  @@index([sentiment])
  @@index([createdAt])
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  workspaceId String

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback    FeedbackTheme[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FeedbackTheme {
  feedbackId String
  themeId    String

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
  @@index([themeId])
}
model Report {
  id          String    @id @default(cuid())
  title       String
  content     String
  createdAt   DateTime  @default(now())

  periodStart DateTime?
  periodEnd   DateTime?

  workspaceId String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
  @@index([periodStart])
  @@index([periodEnd])
}
model Embedding {
  id         String   @id @default(cuid())
  content    String
  vector     String?
  createdAt  DateTime @default(now())
  feedbackId String?

  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model Request {
  id                 String                 @id @default(cuid())
  title              String
  description        String
  category           String?
  status             PublicStatus           @default(UNDER_REVIEW)
  voteCount          Int                    @default(0)

  authorEmail        String?
  notifyOnUpdate     Boolean                @default(true)

  canonicalRequestId String?
  canonicalRequest   Request?               @relation("RequestDuplicates", fields: [canonicalRequestId], references: [id], onDelete: SetNull)
  duplicates         Request[]              @relation("RequestDuplicates")
  duplicateReason    String?

  effort             Int?                   @default(3)
  impact             Int?                   @default(3)

  shippedAt          DateTime?
  releaseNote        String?

  workspaceId        String
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  votes              Vote[]
  statusHistory      RequestStatusHistory[]
  followUps          FollowUpFeedback[]
  notifications      NotificationRecord[]

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, voteCount])
  @@index([canonicalRequestId])
  @@index([createdAt])
}

model Vote {
  id             String    @id @default(cuid())
  requestId      String
  request        Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  voterToken     String
  voterEmail     String?
  notifyOnUpdate Boolean   @default(true)

  createdAt      DateTime  @default(now())

  @@unique([requestId, voterToken])
  @@index([workspaceId])
  @@index([requestId])
  @@index([voterEmail])
}

model RequestStatusHistory {
  id        String        @id @default(cuid())
  requestId String
  request   Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  oldStatus PublicStatus?
  newStatus PublicStatus
  comment   String?
  changedBy String?

  createdAt DateTime      @default(now())

  @@index([requestId])
  @@index([createdAt])
}

model FollowUpFeedback {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  satisfied   Boolean
  comment     String?
  authorEmail String?

  createdAt   DateTime @default(now())

  @@index([requestId])
}

model NotificationRecord {
  id             String       @id @default(cuid())
  requestId      String
  request        Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  recipient      String
  status         PublicStatus
  deliveryStatus String       @default("SENT")
  sentAt         DateTime     @default(now())

  @@unique([requestId, recipient, status])
  @@index([requestId])
  @@index([recipient])
}